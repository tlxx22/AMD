+        n = len(sample_x)
+        for i in range(n - 1):
+            tmp = self.linears[i](sample_x[i])
+            sample_x[i + 1] = torch.add(sample_x[i + 1], tmp, alpha=1.0)
+        # [batch_size, feature_num, seq_len]
+        return sample_x[n - 1]
