+    @staticmethod
+    def _fake_train_epoch(model, *args, **kwargs):
+        with torch.no_grad():
+            model.weight.add_(1.0)
+        value = float(model.weight.item())
+        return {
+            "mse": value,
+            "mae": value,
+            "num_elements": 1,
+            "num_batches": 1,
+            "objective_mean_batches": value,
+            "auxiliary_mean_batches": 0.0,
+        }
