+            manifest["config_hash"] = "different"
+            manifest_path.write_text(json.dumps(manifest), encoding="utf-8")
+            with self.assertRaisesRegex(ValueError, "manifest config hash mismatch"):
+                summary.load_completed_runs(artifacts)
