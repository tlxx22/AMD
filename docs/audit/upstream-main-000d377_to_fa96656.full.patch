+    def forward(self, x):
+        _validate_bcl_input(x, self.seq_len, self.feature_num, "MDM")
+        if self.layernorm:
+            x = self.norm(x)
+        if self.k == 0:
+            return x
+        # x [batch_size, feature_num, seq_len]
